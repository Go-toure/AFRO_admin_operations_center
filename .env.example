# Settings of the Operations Center on a PC. Copy to .env (git-ignored), or create it once with: python tools/make_env.py
# The same names are the Variables of the content on the hosting service. Check with: python run_local.py --check
OPS_LOCAL=1
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=    # the app registration secret
OPS_STORE_SHARE_URL=            # link of the AdminOps folder
OPS_ADMIN_SHARE_URL=            # link of AFRO_admin_data.xlsx
OPS_DICT_SHARE_URL=             # link of AFRO_admin_data_dictionary.xlsx
OPS_SUBMISSIONS_SHARE_URL=      # link of the Admin_data_submissions folder (optional)
GPEI_API_TOKEN=                 # the lookup refresh and the scope refresh
# OPS_WORKDIR=                  # default: the folder ops_work next to app.py
# OPS_PORT=                     # default 8765: the app is always at http://127.0.0.1:8765
# OPS_RSCRIPT=                  # full path of Rscript.exe if R is not found (scope refresh)
# OPS_USERS=                    # only if you want the sign-in page back (see DEPLOY.md, step 4)
